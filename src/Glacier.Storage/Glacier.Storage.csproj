<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Version>1.0.0</Version>
    <PackageId>Glacier.Storage</PackageId>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier</Company>
    <Description>Pure C# .NET 10 zero-allocation columnar Arrow IPC, vectorized Parquet, Clock-Pro buffer pool, ACID WAL, and contiguous binary document engine.</Description>
    <PackageTags>storage parquet arrow ipc buffer-pool wal clock-pro columnar database dotnet csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
