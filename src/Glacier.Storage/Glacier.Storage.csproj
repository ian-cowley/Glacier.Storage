<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <PackageId>Glacier.Storage</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 zero-allocation columnar Arrow IPC, vectorized Parquet, Clock-Pro buffer pool, ACID WAL, and contiguous binary document engine.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Storage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Storage.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>storage;parquet;arrow;ipc;buffer-pool;wal;clock-pro;columnar;database;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
